generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum OccupancyLevel {
  LOW
  MEDIUM
  HIGH
  FULL
}

// ─────────────────────────────────────────
// TABLES
// ─────────────────────────────────────────

model Route {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  origin        String
  destination   String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  routeStations RouteStation[]
  buses         Bus[]
}

model Station {
  id            String         @id @default(uuid())
  name          String
  lat           Float
  lng           Float
  createdAt     DateTime       @default(now())

  routeStations RouteStation[]
}

model RouteStation {
  routeId   String
  stationId String
  order     Int

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([routeId, stationId])
  @@index([routeId])
}

model Bus {
  id        String    @id @default(uuid())
  routeId   String?
  code      String    @unique
  plate     String    @unique
  capacity  Int
  model     String?
  status    BusStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  route     Route?    @relation(fields: [routeId], references: [id])
  reports   Report[]
}

model Report {
  id               String         @id @default(uuid())
  busId            String
  lat              Float
  lng              Float
  passengerCount   Int
  speed            Float?
  occupancyPercent Float
  occupancyLevel   OccupancyLevel
  timestamp        DateTime       @default(now())

  bus              Bus            @relation(fields: [busId], references: [id])

  @@index([busId])
  @@index([timestamp])
}
